{
  "name": "encurtador",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=24.10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "turbo run generate",
    "db:migrate": "pnpm --filter @repo/database run migrate",
    "db:deploy": "pnpm --filter @repo/database run deploy",
    "setup": "pnpm install && pnpm db:generate && pnpm openapi",
    "openapi": "pnpm --filter @repo/api run openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
