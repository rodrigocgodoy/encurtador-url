NODE_ENV=development
HOST=0.0.0.0
PORT=3333
# Base dos links curtos (shortUrl = PUBLIC_URL/r/:code)
PUBLIC_URL=http://localhost:3333
LOG_LEVEL=info
# Lista separada por vírgula, ou * para liberar qualquer origem
CORS_ORIGIN=*

# Postgres na Neon (connection string com ?sslmode=require)
DATABASE_URL=postgresql://user:password@host.neon.tech/encurtador?sslmode=require

# Opcional: chave da API da Anthropic para as rotas de IA (sem ela, respondem 503)
ANTHROPIC_API_KEY=
